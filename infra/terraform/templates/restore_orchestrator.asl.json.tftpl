{
  "Comment": "surviva restore orchestrator: on Spot interruption, find the interrupted instance's CHECKPOINT_COMPLETE jobs, launch a replacement instance from the same launch template, attach any EBS checkpoint volumes, and send a restore command via SSM.",
  "QueryLanguage": "JSONata",
  "TimeoutSeconds": 900,
  "StartAt": "InitVariables",
  "States": {
    "InitVariables": {
      "Type": "Pass",
      "Assign": {
        "azSubnetMap": ${az_subnet_map_json}
      },
      "Next": "WaitForCheckpoints"
    },
    "WaitForCheckpoints": {
      "Type": "Wait",
      "Seconds": ${checkpoint_wait_seconds},
      "Next": "QueryJobs"
    },
    "QueryJobs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Arguments": {
        "TableName": "${table_name}",
        "IndexName": "${gsi_name}",
        "KeyConditionExpression": "instance_id = :iid",
        "ExpressionAttributeValues": {
          ":iid": { "S": "{% $states.input.detail.`instance-id` %}" }
        }
      },
      "Assign": {
        "restorableJobs": "{% $count($states.result.Items[status.S = 'CHECKPOINT_COMPLETE']) > 0 ? $states.result.Items[status.S = 'CHECKPOINT_COMPLETE'][] : [] %}"
      },
      "Next": "AnyRestorableJobs"
    },
    "AnyRestorableJobs": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($restorableJobs) = 0 %}",
          "Next": "NoRestorableJobs"
        }
      ],
      "Default": "DetermineAZ"
    },
    "NoRestorableJobs": {
      "Type": "Succeed"
    },
    "DetermineAZ": {
      "Type": "Pass",
      "Assign": {
        "targetAz": "{% $count($restorableJobs[storage_type.S = 'ebs']) > 0 ? $restorableJobs[storage_type.S = 'ebs'][0].az.S : '' %}"
      },
      "Next": "HasAZOverride"
    },
    "HasAZOverride": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $targetAz != '' and $exists($lookup($azSubnetMap, $targetAz)) %}",
          "Next": "RunInstanceInAZ"
        }
      ],
      "Default": "RunInstanceDefault"
    },
    "RunInstanceInAZ": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:runInstances",
      "Arguments": {
        "LaunchTemplate": {
          "LaunchTemplateId": "${launch_template_id}",
          "Version": "${launch_template_version}"
        },
%{ if replacement_market_type == "spot" ~}
        "InstanceMarketOptions": {
          "MarketType": "spot"
        },
%{ endif ~}
        "MinCount": 1,
        "MaxCount": 1,
        "SubnetId": "{% $lookup($azSubnetMap, $targetAz) %}"
      },
      "Assign": {
        "newInstanceId": "{% $states.result.Instances[0].InstanceId %}"
      },
      "Next": "WaitForInstanceRunning"
    },
    "RunInstanceDefault": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:runInstances",
      "Arguments": {
        "LaunchTemplate": {
          "LaunchTemplateId": "${launch_template_id}",
          "Version": "${launch_template_version}"
        },
%{ if replacement_market_type == "spot" ~}
        "InstanceMarketOptions": {
          "MarketType": "spot"
        },
%{ endif ~}
        "MinCount": 1,
        "MaxCount": 1
      },
      "Assign": {
        "newInstanceId": "{% $states.result.Instances[0].InstanceId %}"
      },
      "Next": "WaitForInstanceRunning"
    },
    "WaitForInstanceRunning": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "DescribeNewInstance"
    },
    "DescribeNewInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Arguments": {
        "InstanceIds": ["{% $newInstanceId %}"]
      },
      "Assign": {
        "instanceState": "{% $states.result.Reservations[0].Instances[0].State.Name %}"
      },
      "Next": "IsInstanceRunning"
    },
    "IsInstanceRunning": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $instanceState = 'running' %}",
          "Next": "WaitForSSMOnline"
        }
      ],
      "Default": "WaitForInstanceRunning"
    },
    "WaitForSSMOnline": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "DescribeSSMInfo"
    },
    "DescribeSSMInfo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
      "Arguments": {
        "Filters": [{ "Key": "InstanceIds", "Values": ["{% $newInstanceId %}"] }]
      },
      "Assign": {
        "ssmOnlineCount": "{% $count($states.result.InstanceInformationList[PingStatus = 'Online']) %}"
      },
      "Next": "IsSSMOnline"
    },
    "IsSSMOnline": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $ssmOnlineCount > 0 %}",
          "Next": "AttachAndRestore"
        }
      ],
      "Default": "WaitForSSMOnline"
    },
    "AttachAndRestore": {
      "Type": "Map",
      "Items": "{% $restorableJobs %}",
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "InitItem",
        "States": {
          "InitItem": {
            "Type": "Pass",
            "Assign": {
              "item": "{% $states.input %}"
            },
            "Next": "IsEBSJob"
          },
          "IsEBSJob": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $item.storage_type.S = 'ebs' %}",
                "Next": "AttachVolume"
              }
            ],
            "Default": "SendRestoreCommand"
          },
          "AttachVolume": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ec2:attachVolume",
            "Arguments": {
              "VolumeId": "{% $item.ebs_volume_id.S %}",
              "InstanceId": "{% $newInstanceId %}",
              "Device": "${ebs_attach_device}"
            },
            "Retry": [
              {
                "ErrorEquals": ["Ec2.Ec2Exception"],
                "IntervalSeconds": 10,
                "MaxAttempts": 10,
                "BackoffRate": 1.3
              }
            ],
            "Next": "WaitForVolumeAttached"
          },
          "WaitForVolumeAttached": {
            "Type": "Wait",
            "Seconds": 5,
            "Next": "DescribeVolumeForAttach"
          },
          "DescribeVolumeForAttach": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
            "Arguments": {
              "VolumeIds": ["{% $item.ebs_volume_id.S %}"]
            },
            "Assign": {
              "attachState": "{% $states.result.Volumes[0].Attachments[0].State %}"
            },
            "Next": "IsVolumeAttached"
          },
          "IsVolumeAttached": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $attachState = 'attached' %}",
                "Next": "SendRestoreCommand"
              }
            ],
            "Default": "WaitForVolumeAttached"
          },
          "SendRestoreCommand": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
            "Arguments": {
              "InstanceIds": ["{% $newInstanceId %}"],
              "DocumentName": "${restore_ssm_document}",
              "Parameters": {
                "commands": ["{% '${restore_command_prefix} ' & $item.job_id.S %}"]
              },
              "CloudWatchOutputConfig": {
                "CloudWatchLogGroupName": "${cloudwatch_log_group_name}",
                "CloudWatchOutputEnabled": true
              }
            },
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
